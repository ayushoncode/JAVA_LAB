package PGM12;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.HashMap;

public class ShoppingApp extends JFrame implements ActionListener {

    JTextField t1, t2, t3;
    JButton btn;

    HashMap<Integer, String> customers = new HashMap<>();
    HashMap<Integer, String> itemname = new HashMap<>();
    HashMap<Integer, Double> itemprice = new HashMap<>();

    boolean isNewCustomer;

    ShoppingApp() {

        String user = JOptionPane.showInputDialog("Enter Username");
        String pass = JOptionPane.showInputDialog("Enter Password");

        if (!user.equals("admin") || !pass.equals("123")) {
            JOptionPane.showMessageDialog(this, "Invalid Login");
            System.exit(0);
        }

        JOptionPane.showMessageDialog(this, "Login Successful");

        // Ask customer type at start
        int choice = JOptionPane.showConfirmDialog(
                this,
                "Are you a New Customer?",
                "Customer",
                JOptionPane.YES_NO_OPTION);

        if (choice == JOptionPane.YES_OPTION)
            isNewCustomer = true;
        else
            isNewCustomer = false;

        customers.put(101, "Ayush");
        customers.put(102, "Rahul");

        itemname.put(1, "Laptop");
        itemprice.put(1, 50000.0);

        itemname.put(2, "Mouse");
        itemprice.put(2, 500.0);

        setLayout(new GridLayout(4, 2));

        add(new JLabel("Customer ID"));
        t1 = new JTextField();
        add(t1);

        add(new JLabel("Item ID"));
        t2 = new JTextField();
        add(t2);

        add(new JLabel("Quantity"));
        t3 = new JTextField();
        add(t3);

        btn = new JButton("Purchase");
        btn.addActionListener(this);
        add(btn);

        setSize(300, 200);
        setVisible(true);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
    }

    @Override
    public void actionPerformed(ActionEvent e) {

        try {

            int customerid = Integer.parseInt(t1.getText());
            int itemid = Integer.parseInt(t2.getText());
            int qty = Integer.parseInt(t3.getText());

            if (isNewCustomer) {

                String name = JOptionPane.showInputDialog(
                        "Enter Customer Name");

                customers.put(customerid, name);

            } else {

                if (!customers.containsKey(customerid)) {
                    JOptionPane.showMessageDialog(this,
                            "Customer Not Found");
                    return;
                }
            }

            if (!itemname.containsKey(itemid)) {
                JOptionPane.showMessageDialog(this,
                        "Invalid Item ID");
                return;
            }

            String itemName = itemname.get(itemid);
            double total = itemprice.get(itemid) * qty;

            JOptionPane.showMessageDialog(this,
                    "Item : " + itemName +
                    "\nTotal Cost : Rs. " + total);

        } catch (Exception ex) {

            JOptionPane.showMessageDialog(this,
                    "Invalid Input");
        }
    }

    public static void main(String[] args) {
        new ShoppingApp();
    }
}
